{
  "name": "WEB-Interia",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash -lc 'if ! command -v php >/dev/null; then sudo apt-get update && sudo apt-get install -y php-cli php-mbstring php-xml php-curl php-zip php-pgsql php-sqlite3; fi'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "WEB-Interia",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore",
    "visibility": "private"
  },
  "postStartCommand": "bash .devcontainer/codespace-start.sh",
  "postAttachCommand": "bash .devcontainer/codespace-start.sh"
}
